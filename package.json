{
  "name": "brandshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local:setup": "node scripts/setup-local-preview.mjs",
    "local:dev": "npm --prefix .local-preview/app run dev",
    "local:build": "npm --prefix .local-preview/app run build",
    "local:preview": "npm --prefix .local-preview/app run preview",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.9.3"
  }
}
